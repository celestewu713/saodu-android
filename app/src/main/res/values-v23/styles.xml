    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#1E5BB8</item>
        <item name="android:colorPrimaryDark">#1E5BB8</item>
        <item name="android:colorAccent">#1E5BB8</item>
        <item name="android:windowBackground">#F4F7FC</item>
        <item name="android:statusBarColor">#F4F7FC</item>
        <item name="android:navigationBarColor">#F4F7FC</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
